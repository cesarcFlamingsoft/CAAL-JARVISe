# JARVIS provider OAuth configuration template
# Copy to a local secret file. Do not commit or send its contents in chat.
# Required callback registered with every provider:
# https://jarvis.mexcantech.io/api/connections/callback

CAAL_PUBLIC_ORIGIN=https://jarvis.mexcantech.io

# Google
CAAL_OAUTH_GOOGLE_CLIENT_ID=963056231862-nbj5trhevbqjt5d0klj566nmeg0tau6a.apps.googleusercontent.com
CAAL_OAUTH_GOOGLE_CLIENT_SECRET=<set-in-local-secret-file>
CAAL_OAUTH_GOOGLE_SCOPES=openid email https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/gmail.readonly

# Microsoft / Outlook
CAAL_OAUTH_MICROSOFT_CLIENT_ID=225a0362-eb19-45d6-8f23-f4fb504d066c
CAAL_OAUTH_MICROSOFT_CLIENT_SECRET=<set-in-local-secret-file>
CAAL_OAUTH_MICROSOFT_TENANT=common
CAAL_OAUTH_MICROSOFT_SCOPES=openid email offline_access User.Read Mail.Read Calendars.Read

# Zoho. Change domain if your account uses a non-.com Zoho data center.
CAAL_OAUTH_ZOHO_CLIENT_ID=1000.9XNCJH9IPJHJA1RX09VDOB0ZYPV4SL
CAAL_OAUTH_ZOHO_CLIENT_SECRET=<set-in-local-secret-file>
CAAL_OAUTH_ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# Zoho scope syntax is provider-specific; leave this line blank until the
# server-side Zoho exchange implementation has been finalized and tested.
CAAL_OAUTH_ZOHO_SCOPES=
