port: 7880
log_level: info
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}

rtc:
  use_external_ip: false
  tcp_port: 7881
  # Must match the published Docker UDP range exactly.  These values are sent
  # to browsers as ICE candidates, not translated through Docker's mapping.
  port_range_start: 50100
  port_range_end: 50200

# TURN/TLS for remote access (Tailscale or mkcert)
turn:
  enabled: true
  domain: ${HTTPS_DOMAIN}
  tls_port: 5349
  cert_file: /etc/livekit/certs/server.crt
  key_file: /etc/livekit/certs/server.key
  relay_range_start: 30000
  relay_range_end: 30100
  external_tls: true
