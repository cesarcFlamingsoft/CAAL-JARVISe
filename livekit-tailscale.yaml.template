port: 7880
log_level: info
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}

rtc:
  # Public browser clients must receive the WAN candidate rather than this
  # Mac's RFC1918 address; Cloudflare carries signalling, not WebRTC media.
  use_external_ip: true
  # One publicly mapped UDP port is sufficient for this single-node server and
  # avoids the router's failed 101-port UPnP range allocation.
  udp_port: 7881
  tcp_port: 7881

# TURN/TLS for remote access (Tailscale or mkcert)
turn:
  enabled: true
  domain: ${HTTPS_DOMAIN}
  tls_port: 5349
  cert_file: /etc/livekit/certs/server.crt
  key_file: /etc/livekit/certs/server.key
  relay_range_start: 30000
  relay_range_end: 30100
  external_tls: true
